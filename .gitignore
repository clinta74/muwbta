# ---- .NET ----
bin/
obj/
[Dd]ebug/
[Rr]elease/
artifacts/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
*.received.*

# ---- Node / client ----
node_modules/
client/dist/
client/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ---- Local configuration and secrets ----
# .env holds local docker-compose credentials; .env.example is committed instead.
.env
*.local
appsettings.Local.json
appsettings.*.Local.json

# ---- Database dumps and content exports ----
# Written by tools/export-content.ps1 and by pg_dump. Ignored as a directory because what lands
# here is not uniform: a content export is harmless, but a full dump carries every account's
# email and password hash, and one careless commit publishes them. A world snapshot worth keeping
# in history should be committed by path, deliberately, after reading it.
backups/

# Where tools/merge-bundles.py writes. A merged bundle is derived from content/, byte-for-byte
# reproducible from it, and 6x the same words — committing one would make it a second source of
# truth that drifts from the files it was built from, and the drift would be invisible in a diff
# that large. Rebuild it at import time instead.
build/

# ---- Tooling ----
.idea/
.DS_Store
Thumbs.db
coverage/
TestResults/
*.coverage
*.trx

__pycache__/

# Worktrees created by the agent harness. Each is a checkout of this repo.
.claude/worktrees/

# Playtest and load-run output. A run directory is an artefact of one execution — the
# transcripts and histograms are for reading now, not for keeping in history.
runs/
# The beta compose carries live credentials for a running server and must never be committed.
# It was, once, in eda9922, and the passwords in it had to be rotated. The other files here are
# deployment examples with every secret blank - they stay tracked, because
# ComposeConfigurationKeysTests reads them and is what catches a Sessions__ key that binds to
# nothing (it caught one in each of two files this week).
tmp/

# MCP server registration. The muwbta entry carries a live builder session cookie in its env
# block (tools/Muwbta.Mcp/README.md), which is a credential for a role that can rewrite the
# world. Same reasoning as the beta compose above, before rather than after.
.mcp.json
