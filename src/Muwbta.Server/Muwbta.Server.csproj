<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>muwbta-server</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Muwbta.Engine\Muwbta.Engine.csproj" />
    <ProjectReference Include="..\Muwbta.Persistence\Muwbta.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    The default blocked-words list, embedded because the container publishes /app/publish and there
    is no shipped/ beside the server in the image.

    Embedded where the realm maps deliberately are not, and the difference is what each one can
    disagree with. A map is drawn from authored rooms, so a build that carries its own can describe
    a world the database no longer holds - which is why those travel as content now. This list is
    derived from nothing: it is the engine's own floor, like the four abilities in AbilityCatalogue,
    and it is only ever a starting value. Once a configuration has one, the database is the
    authority and this is not consulted again.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\shipped\blocked-words.txt">
      <LogicalName>Muwbta.Server.BlockedWords.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- WebApplicationFactory in the integration tests needs to see the entry point. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Muwbta.Server.Tests" />
  </ItemGroup>

</Project>
